<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to: android/app/src/main/res/xml/network_security_config.xml

  Android 9+ blocks cleartext (http://) traffic by default. The Hematix
  backend runs on plain http://…:8080 during development, so these hosts
  are allowlisted explicitly rather than enabling cleartext app-wide.

  Add your machine's LAN IP below when testing on a physical device.
  Remove this file entirely once the backend is served over HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator's alias for the host machine -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- e.g. <domain includeSubdomains="true">192.168.1.14</domain> -->
    </domain-config>
</network-security-config>
